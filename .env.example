# Environment Variables
# Copy this file to .env and update with your values

# Cloudflare Worker API URL
# After deploying your worker, update this with your worker URL
# Example: https://letterhead-api.your-subdomain.workers.dev
VITE_API_URL=http://localhost:8787

# Your Cloudflare Pages URL (for generating shareable links)
# Example: https://tajmir-letterhead.pages.dev
VITE_APP_URL=http://localhost:5173
